<?xml version="1.0" encoding="utf-8"?>
<!--
    Bubble layout: vòng pulse bên ngoài + nền tròn + icon app + badge nhỏ
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="64dp">

    <!-- Vòng pulse ngoài (animation scale/alpha) -->
    <View
        android:id="@+id/bubbleRing"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_ring" />

    <!-- Nền tròn chính -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_bg"
        android:elevation="8dp">

        <!-- Icon app thay vì system icon -->
        <ImageView
            android:id="@+id/bubbleIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <!-- Badge đỏ khi vừa phát hiện quảng cáo -->
    <FrameLayout
        android:id="@+id/bubbleBadge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bubble_badge_bg"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="!"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
